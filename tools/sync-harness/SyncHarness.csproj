<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>sync-harness</AssemblyName>
    <RootNamespace>BugFarmer.SyncHarness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same Nakama .NET client the Unity package wraps; protocol-compatible with server 3.35.0.
         useMainThread is Unity-only, so headless runs the SDK's own dispatch — exactly the
         variable we isolate vs the Unity main-thread pump. -->
    <PackageReference Include="NakamaClient" Version="3.13.0" />
  </ItemGroup>

</Project>
