# Build stage for Go runtime module
FROM registry.heroiclabs.com/heroiclabs/nakama-pluginbuilder:3.35.0

# Set working directory
WORKDIR /backend

# Copy go.mod and go.sum first for caching
COPY go.mod go.sum ./

# Copy source code first (needed for go mod tidy to analyze imports)
COPY . .

# Sync dependencies with code imports
RUN go mod tidy

# Download dependencies
RUN go mod download

# Build the shared library
RUN go build -buildmode=plugin -trimpath -o ./backend.so

# Override entrypoint and copy the built .so to output volume. Copy to a new name, then RENAME over the old one:
# a running server keeps its already-open file, so rebuilding while someone plays no longer crashes it (copying
# straight over the live file rewrote it under the running server — a SIGSEGV).
ENTRYPOINT []
CMD ["/bin/sh", "-c", "cp /backend/backend.so /output/backend.so.new && mv -f /output/backend.so.new /output/backend.so"]
