# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
# Unanchored: the Unity project lives in BugFarmerClient/, so a root-anchored
# pattern never matches (editor-layout churn was being tracked).
[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ============================================================================
# Project-specific. The Unity project is nested under BugFarmerClient/, so the
# root-anchored Unity rules above (/[Ll]ibrary/ etc.) do NOT match it. Re-ignore
# the nested generated/cache dirs explicitly.
# ============================================================================
BugFarmerClient/[Ll]ibrary/
BugFarmerClient/[Tt]emp/
BugFarmerClient/[Oo]bj/
BugFarmerClient/[Bb]uild/
BugFarmerClient/[Bb]uilds/
BugFarmerClient/[Ll]ogs/
BugFarmerClient/[Mm]emoryCaptures/

# Secrets (OpenAI API key for the sprite pipeline)
.env
tools/.env

# Python tooling
__pycache__/
*.pyc

# Sprite/world pipeline output: regenerable, kept on disk but out of git.
# raw API images, cleaned-sprite staging, scene previews, world renders.
tools/_generated/
# EXCEPT the ecology tuning structure: keep the per-zone READMEs + the CURRENT-setup and comparison charts
# in git so the live ecology is visible in the repo. The bulky per-run archive + raw logs/CSVs stay ignored.
# Un-ignore-nested pattern: re-include each ANCESTOR dir (git won't descend into an excluded dir), re-ignore
# its other contents, then re-include the wanted leaves.
!tools/_generated/
tools/_generated/*
# EXCEPT the committed player-art docs: the _generated MAP + the player/ structure docs + the current-look
# preview. The STRUCTURE is tracked (visible in the repo); the WIP images stay ignored (local-only). Nested idiom.
!tools/_generated/README.md
!tools/_generated/player/
tools/_generated/player/*
# The APPROVED animations and the decisions behind them are PRODUCT, not scratch. They are tracked.
# Excluding the art from git, then overwriting it, is what lost a day of approved work on 2026-08-01.
!tools/_generated/player/APPROVED/
!tools/_generated/player/APPROVED/**
!tools/_generated/player/README.md
!tools/_generated/player/HOW_TO_ASEPRITE.md
# bases/ is an INPUT, not output: the two official sprites (armless front + armless side) every outfit is
# generated onto. They can't be re-derived — the side is one specific API roll chosen out of many — so losing
# them costs real work and would silently put every outfit off-register. Exactly two files live here.
!tools/_generated/player/bases/
!tools/_generated/player/bases/**
# THE OUTFIT ART IS THE PRODUCT AND IS TRACKED. Every sprite sheet, every cut frame, every hand, every
# finished animation. This was ignored until 2026-08-01, which is exactly how a day of approved work was
# lost: nothing here was recoverable, so when I overwrote it with a bulk re-cut there was no undo.
# Art is not scratch. The only things that belong in .gitignore are secrets and genuinely regenerable
# temporaries.
!tools/_generated/player/outfits/
!tools/_generated/player/outfits/**
!tools/_generated/player/props/
!tools/_generated/player/props/**
# The design-exploration sheets: the evidence behind which look was chosen.
!tools/_generated/player/explore/
!tools/_generated/player/explore/**
# archive/ stays OUT: ~1.1 GB, and almost all of it is DEMO.gif preview renders at 27 MB each that
# regenerate from the sprites in one command. The sprites themselves are tracked above, so nothing
# unrecoverable lives in there. Say the word and it goes in too.
# Tile R&D: keep the findings + the two comparison sheets (the evidence) in git; raws/candidates stay local.
!tools/_generated/tiles/
tools/_generated/tiles/*
!tools/_generated/tiles/README.md
!tools/_generated/tiles/previews/
tools/_generated/tiles/previews/*
!tools/_generated/tiles/previews/_GRID_COMPARE.png
!tools/_generated/tiles/previews/_ALL_CANDIDATES.png
!tools/_generated/ecology_charts/
tools/_generated/ecology_charts/*
!tools/_generated/ecology_charts/README.md
!tools/_generated/ecology_charts/*/
tools/_generated/ecology_charts/*/*
!tools/_generated/ecology_charts/*/README.md
!tools/_generated/ecology_charts/*/current/
!tools/_generated/ecology_charts/*/current/**
!tools/_generated/ecology_charts/*/comparisons/
!tools/_generated/ecology_charts/*/comparisons/**

# One-off API response dumps and scratch sprite iterations
tools/response*.json
tools/honeybee*.png
/Untitled.png
/diagonaltile.png

# Claude Code runtime artifacts (transient — never track)
.claude/scheduled_tasks.lock
.claude/hooks/_smoke.log
